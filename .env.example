# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Frontend ──────────────────────────────────────────────
FRONTEND_URL=https://app.conectaachat.com
# Comma-separated list of allowed CORS origins (optional)
# FRONTEND_URL=https://app.conectaachat.com,https://other.com

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ── Anthropic (LLM) ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (embeddings for RAG) ───────────────────────────
OPENAI_API_KEY=sk-...

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_PRICE_CREDITS_1K=price_...
STRIPE_PRICE_CREDITS_5K=price_...
STRIPE_PRICE_CREDITS_20K=price_...

# ── Meta — Facebook Messenger app ─────────────────────────
# App ID and secret for the Facebook app (used for FB Messenger + WhatsApp OAuth)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
# Aliases — set these to the same values as above (some code reads META_ prefix)
META_APP_ID=your_facebook_app_id
META_APP_SECRET=your_facebook_app_secret
# Webhook verify token — set this to a random string and configure it in Meta Portal
META_VERIFY_TOKEN=your_random_verify_token_string
# OAuth redirect URIs — must match exactly what is registered in Meta Portal
FACEBOOK_REDIRECT_URI=https://api.conectaachat.com/api/integrations/facebook/callback
WHATSAPP_REDIRECT_URI=https://api.conectaachat.com/api/integrations/whatsapp/callback

# ── Meta — Instagram Business Login app ───────────────────
# Separate Meta app for Instagram Business Login (graph.instagram.com API)
# App ID: 4288619228119210
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
# Redirect URI — must be registered in Meta Portal under Instagram Business Login product
# Fixed value: https://api.conectaachat.com/api/integrations/instagram/callback

# ── WhatsApp Business (legacy env fallback) ───────────────
# Only needed if using env-based WA config instead of per-channel DB config
WHATSAPP_API_TOKEN=your_whatsapp_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# ── Slack ─────────────────────────────────────────────────
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_SIGNING_SECRET=your_slack_signing_secret
SLACK_REDIRECT_URI=https://api.conectaachat.com/api/integrations/slack/callback
